[Unit]
Description=Pixel Deck coast surf feed, daily satellite water temperature refresh (NOAA CoastWatch MUR; fills the cache the 30-minute run reads)
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/ops/bin/deck-feed-surf-coast --tier sat
TimeoutStartSec=3600
Nice=15
IOSchedulingClass=idle
MemoryMax=1G
